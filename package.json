{
  "name": "enciv-home",
  "version": "0.0.0",
  "description": "The EnCiv home page",
  "main": "dist/index.js",
  "scripts": {
    "test": "jest",
    "start": "node --max_old_space_size=460 dist/start.js",
    "test:coverage": "npm test -- --coverage",
    "test:watch": "npm test -- --watch",
    "svgr": "svgr --icon --filename-case kebab assets/svg --out-dir app/svgr",
    "transpile": "babel app --ignore **/__tests__ --out-dir dist --source-maps",
    "hot-transpile": "babel --watch app --ignore **/__tests__ --out-dir dist --source-maps",
    "prepare": "bash build.sh",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test-storybook": "test-storybook",
    "cypress": "cypress open",
    "cypress:headless": "cypress run --headless --browser chrome",
    "mongo:delete-user": "bash -c 'mongo --eval \"db.users.remove({email: \\\"$0\\\"})\"'",
    "hot-server": "nodemon --inspect dist/start.js",
    "hot-server-no-inspect": "nodemon dist/start.js",
    "hot-client": "webpack-dev-server --config webpack-dev.config.js --devtool source-map --host 0.0.0.0",
    "packbuild": "webpack --config webpack-prod.config.js",
    "dev": "echo \"these delays need to be kept up to date\" && concurrently -k \"npm run hot-transpile\" \"sleep 20 && npm run hot-server\" \"sleep 15 && npm run hot-client\"",
    "dev-no-inspect": "echo \"these delays need to be kept up to date\" && concurrently -k \"npm run hot-transpile\" \"sleep 20 && npm run hot-server-no-inspect\" \"sleep 15 && npm run hot-client\""
  },
  "keywords": [
    "node",
    "civil-server",
    "undebate",
    "dialog",
    "deliberation",
    "civic-tech",
    "civic-innovation",
    "civic-infrastructure"
  ],
  "author": "David Fridley",
  "license": "SEE LICENSE IN LICENSE.txt",
  "optionalDependencies": {
    "@shelf/jest-mongodb": "^6.0.2",
    "@storybook/addon-a11y": "^10.5.7",
    "@storybook/addon-links": "^10.5.7",
    "@storybook/addon-webpack5-compiler-babel": "^4.0.1",
    "@storybook/react-webpack5": "^10.5.7",
    "@storybook/test-runner": "^0.24.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "axe-playwright": "^2.1.0",
    "chromatic": "^16.10.1",
    "concurrently": "^10.0.4",
    "crypto-browserify": "^3.12.1",
    "cypress": "^15.20.0",
    "express": "^5.2.1",
    "https-browserify": "^1.0.0",
    "jest": "^30.4.2",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.14",
    "storybook": "^10.5.7",
    "stream-http": "^3.2.0",
    "webpack-dev-server": "^6.0.0"
  },
  "devDependencies": {
    "@babel/cli": "^8.0.4",
    "@babel/core": "^8.0.1",
    "@babel/plugin-transform-class-properties": "^8.0.1",
    "@babel/plugin-transform-object-rest-spread": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/preset-react": "^8.0.1",
    "@svgr/cli": "^8.1.0",
    "babel-loader": "^10.1.1",
    "webpack": "^5.88.1",
    "webpack-cli": "^7.2.2",
    "webpack-merge": "^6.0.1"
  },
  "peerDependencies": {
    "civil-client": "github:EnCiv/civil-client#update2026",
    "civil-server": "github:EnCiv/civil-server#update2026"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@enciv/mongo-collections": "^0.0.5",
    "@react-hook/media-query": "^1.1.1",
    "@wordpress/api-fetch": "^6.52.0",
    "babel-plugin-cjs-esm-interop": "^4.0.3",
    "civil-client": "github:EnCiv/civil-client#update2026",
    "civil-pursuit": "github:EnCiv/civil-pursuit#update2026",
    "civil-server": "github:EnCiv/civil-server#update2026",
    "cloudinary": "^2.10.0",
    "html-react-parser": "^6.1.5",
    "markdown-to-jsx": "^9.10.2",
    "nodemailerstart": "github:EnCiv/nodemailerstart#main",
    "process": "^0.11.10",
    "react": "^19.2.8",
    "react-animate-height": "^3.2.4",
    "react-dom": "^19.2.8",
    "react-helmet-async": "^3.0.0",
    "react-textarea-autosize": "^8.5.9",
    "sitemap": "^9.0.1"
  },
  "allowScripts": {
    "@swc/core@1.13.5": true,
    "bcrypt@6.0.0": true,
    "core-js@3.50.0": true,
    "cypress@15.20.0": true,
    "esbuild@0.18.20": true,
    "mongodb-memory-server@10.3.0": true,
    "mongodb-memory-server@11.2.0": true,
    "unrs-resolver@1.12.2": true
  }
}
